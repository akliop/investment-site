{
  "version": 2,
  "builds": [
    {
      "src": "investment_site.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/auth/v1/sync",
      "dest": "investment_site.py"
    },
    {
      "src": "/sync",
      "dest": "investment_site.py"
    },
    {
      "src": "/register",
      "dest": "investment_site.py"
    },
    {
      "src": "/(.*)",
      "dest": "investment_site.py"
    }
  ]
}
